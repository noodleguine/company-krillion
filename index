    };

    // Active mutable config (loaded from localStorage if customized, otherwise DEFAULT_GAME_CONFIG)
    let GAME_CONFIG = loadSavedConfig();

    function loadSavedConfig() {
      try {
        const saved = localStorage.getItem("clover_krillion_config_v1");
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed && parsed.rounds && parsed.rarityTiers) {
            return parsed;
          }
        }
      } catch (e) {
