<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clover Krillion — Clover Network, Inc. (A Fiserv Company)</title>
  <!-- Tailwind CSS via CDN for sleek, responsive styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans & Inter for crisp Clover fintech typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --font-display: 'Plus Jakarta Sans', sans-serif;
      --font-body: 'Inter', sans-serif;
      --clover-green: #43B02A;
      --clover-dark: #18221B;
      --fiserv-orange: #FF6600;
    }

    body {
      font-family: var(--font-body);
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      background-color: #FFFFFF;
      color: #18221B;
      user-select: none;
    }

    h1, h2, h3, .font-display {
      font-family: var(--font-display);
    }

    /* Lively Gentle Movement Animations */
    @keyframes floatBob {
      0%, 100% { transform: translateY(0px) rotate(-1.5deg); }
      50% { transform: translateY(-8px) rotate(2deg); }
    }

    @keyframes hardwareHover {
      0%, 100% { transform: translateY(0px) scale(1); }
      50% { transform: translateY(-5px) scale(1.04); }
    }

    @keyframes shakeError {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-8px) rotate(-2deg); }
      40% { transform: translateX(8px) rotate(2deg); }
      60% { transform: translateX(-6px) rotate(-1deg); }
      80% { transform: translateX(6px) rotate(1deg); }
    }

    @keyframes unlockPop {
      0% { transform: translateY(10px) scale(0.92); opacity: 0.4; }
      50% { transform: translateY(-10px) scale(1.06); opacity: 1; }
      100% { transform: translateY(0) scale(1); opacity: 1; }
    }

    @keyframes popIn {
      0% { opacity: 0; transform: scale(0.94) translateY(10px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }

    .animate-bob {
      animation: floatBob 3.6s ease-in-out infinite;
    }

    .animate-hw {
      animation: hardwareHover 3.2s ease-in-out infinite;
    }

    .animate-shake {
      animation: shakeError 0.42s cubic-bezier(.36,.07,.19,.97) both;
    }

    .animate-dive {
      animation: unlockPop 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .animate-pop {
      animation: popIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Tactile Clover POS Buttons */
    .btn-game {
      transition: all 0.16s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 0 rgba(24, 34, 27, 0.18), 0 8px 18px rgba(67, 176, 42, 0.18);
    }
    .btn-game:hover:not(:disabled) {
      transform: translateY(-2px);
      filter: brightness(1.04);
    }
    .btn-game:active:not(:disabled) {
      transform: translateY(2px);
      box-shadow: 0 1px 0 rgba(24, 34, 27, 0.18), 0 3px 8px rgba(67, 176, 42, 0.15);
    }

    /* Crisp White & Mint Clover Cards */
    .clover-card {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1.5px solid #D5E8DA;
      box-shadow: 0 16px 40px rgba(24, 34, 27, 0.07), 0 2px 6px rgba(67, 176, 42, 0.06);
    }

    /* Custom Scrollbar for White Clover Theme */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #F0F7F2;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb {
      background: #A7D7B5;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #43B02A;
    }

    /* Input focus ring */
    input:focus, textarea:focus, select:focus {
      outline: none;
      border-color: #43B02A !important;
      box-shadow: 0 0 0 3px rgba(67, 176, 42, 0.22);
    }
  </style>
</head>
<body class="min-h-screen relative selection:bg-[#43B02A] selection:text-white">

  <!-- Full-Screen Dynamic Clover Canvas (Drifting Four-Leaf Clovers, Soft Mint Ripples, Floating Hardware Silhouettes) -->
  <canvas id="cloverCanvas" class="fixed inset-0 w-full h-full pointer-events-none z-0"></canvas>

  <!-- Subtle White-to-Mint Ambient Gradient Overlay -->
  <div id="depthOverlay" class="fixed inset-0 pointer-events-none z-0 transition-colors duration-1000"
       style="background: radial-gradient(circle at 50% 0%, rgba(67, 176, 42, 0.08), rgba(244, 250, 246, 0.82) 75%, rgba(255, 255, 255, 0.95) 100%);"></div>

  <!-- Toast Notification Banner (Replaces alert() cleanly) -->
  <div id="toastContainer" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 pointer-events-none w-11/12 max-w-md"></div>

  <!-- Main Application Shell -->
  <div id="app" class="relative z-10 min-h-screen flex flex-col justify-between p-3 sm:p-5 max-w-6xl mx-auto">

    <!-- Top Navigation / Clover & Fiserv Header -->
    <header class="flex flex-wrap items-center justify-between gap-3 py-2.5 px-4 rounded-2xl clover-card">
      <div class="flex items-center gap-3 cursor-pointer" onclick="App.confirmReturnHome()">
        <div id="headerMascotBadge" class="w-11 h-11 rounded-xl bg-[#EAF7EC] flex items-center justify-center shadow-sm border border-[#BFE3C6] animate-bob">
          <!-- Stylized Clover Leaf Emblem injected by JS -->
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-1.5">
            <span id="headerCompanyTag" class="text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-[#EAF7EC] text-[#287A18] border border-[#BFE3C6]">
              CLOVER NETWORK, INC.
            </span>
            <span class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#FFF2E8] text-[#D95300] border border-[#FFD1B3]">
              A Fiserv Company
            </span>
            <span id="liveSyncBadge" class="hidden text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300 flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-[#43B02A] animate-ping"></span> LIVE SYNC
            </span>
          </div>
          <h1 id="headerGameTitle" class="text-xl sm:text-2xl font-extrabold tracking-tight text-[#18221B] leading-tight mt-0.5">
            CLOVER KRILLION
          </h1>
        </div>
      </div>

      <!-- Right Header Controls: Score Readout + Audio Toggle + Customize Button -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Live Points Pill (Visible during gameplay) -->
        <div id="headerDepthPill" class="hidden items-center gap-2 px-3.5 py-1.5 rounded-xl bg-[#F4FAF6] border border-[#BFE3C6]">
          <span class="text-xs text-[#287A18] font-bold uppercase">Top Score</span>
          <span id="headerDepthValue" class="font-display font-extrabold text-lg text-[#18221B]">0 pts</span>
        </div>

        <!-- Sound Toggle -->
        <button id="soundToggleBtn" onclick="SoundEngine.toggle()" title="Toggle POS Chime Audio"
                class="p-2.5 rounded-xl bg-[#F4FAF6] hover:bg-[#E4F3E8] border border-[#CBE6D1] text-[#18221B] transition">
          <span id="soundIcon">🔊</span>
        </button>

        <!-- Customize Studio Button -->
        <button onclick="Customizer.open()"
                class="btn-game px-3.5 py-2 rounded-xl bg-[#43B02A] hover:bg-[#389922] text-white font-bold text-xs sm:text-sm flex items-center gap-1.5 border border-[#328A1E]">
          <span>🎨</span>
          <span class="hidden sm:inline">Customize & Export</span>
          <span class="sm:hidden">Edit</span>
        </button>
      </div>
    </header>

    <!-- Dynamic Screen Container -->
    <main id="screenContainer" class="flex-1 flex flex-col justify-center my-4">
      <!-- Screens are rendered dynamically here by App.render() -->
    </main>

    <!-- Footer Clover Hardware Rarity Scale -->
    <footer class="py-2.5 px-4 rounded-2xl clover-card flex flex-wrap items-center justify-between gap-2 text-xs text-[#37473C]">
      <div class="flex items-center gap-2">
        <span class="font-extrabold text-[#287A18]">Clover Rarity Ladder:</span>
        <span class="hidden lg:inline text-[#526658]">Rarer valid answers unlock higher-tier Clover hardware!</span>
      </div>
      <div id="footerTierPills" class="flex flex-wrap items-center gap-1.5">
        <!-- Populated dynamically from GAME_CONFIG.rarityTiers -->
      </div>
    </footer>
  </div>

  <!-- =====================================================================
       CUSTOMIZATION STUDIO & GITHUB PAGES EXPORT MODAL
       ===================================================================== -->
  <div id="customizerModal" class="fixed inset-0 z-50 hidden items-center justify-center p-2 sm:p-4 bg-[#18221B]/60 backdrop-blur-sm">
    <div class="bg-white w-full max-w-5xl max-h-[92vh] rounded-3xl flex flex-col overflow-hidden border-2 border-[#BFE3C6] shadow-2xl animate-pop">
      <!-- Modal Header -->
      <div class="px-5 py-4 bg-[#F4FAF6] border-b border-[#D5E8DA] flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#18221B] flex items-center gap-2">
            <span>🍀</span> Clover Krillion Studio
          </h2>
          <p class="text-xs text-[#4A5D50]">Swap placeholder hardware SVGs with custom PNGs/emojis, edit all 14 questions, and export a standalone <code class="text-[#287A18] font-bold">index.html</code> for GitHub Pages.</p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="Customizer.exportStaticHTML()"
                  class="btn-game px-4 py-2 rounded-xl bg-[#43B02A] text-white font-bold text-xs sm:text-sm flex items-center gap-1.5">
            <span>⬇️</span> Download GitHub Pages HTML
          </button>
          <button onclick="Customizer.close()"
                  class="p-2 rounded-xl bg-white hover:bg-[#E4F3E8] border border-[#CBE6D1] text-[#18221B] font-bold text-sm">
            ✕
          </button>
        </div>
      </div>

      <!-- Studio Tabs -->
      <div class="flex border-b border-[#D5E8DA] bg-white px-4 gap-2 overflow-x-auto">
        <button onclick="Customizer.switchTab('branding')" id="tabBtn-branding"
                class="studio-tab px-4 py-3 text-sm font-bold border-b-2 border-[#43B02A] text-[#287A18] whitespace-nowrap">
          1. Branding & Theme
        </button>
        <button onclick="Customizer.switchTab('assets')" id="tabBtn-assets"
                class="studio-tab px-4 py-3 text-sm font-bold border-b-2 border-transparent text-[#5A6E60] hover:text-[#18221B] whitespace-nowrap">
          2. Clover Hardware Assets & Mascot
        </button>
        <button onclick="Customizer.switchTab('questions')" id="tabBtn-questions"
                class="studio-tab px-4 py-3 text-sm font-bold border-b-2 border-transparent text-[#5A6E60] hover:text-[#18221B] whitespace-nowrap">
          3. Questions & Rarity Lists (2×7)
        </button>
        <button onclick="Customizer.switchTab('github')" id="tabBtn-github"
                class="studio-tab px-4 py-3 text-sm font-bold border-b-2 border-transparent text-[#5A6E60] hover:text-[#18221B] whitespace-nowrap">
          4. GitHub Pages & Live Host Guide
        </button>
      </div>

      <!-- Modal Scrollable Content -->
      <div id="customizerBody" class="p-5 overflow-y-auto flex-1 space-y-6 bg-[#FAFCFA]">
        <!-- Populated dynamically by Customizer -->
      </div>

      <!-- Modal Footer -->
      <div class="px-5 py-3.5 bg-[#F4FAF6] border-t border-[#D5E8DA] flex flex-wrap items-center justify-between gap-3">
        <button onclick="Customizer.resetToDefaults()"
                class="px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold">
          Reset to Clover Default Template
        </button>
        <div class="flex items-center gap-2">
          <button onclick="Customizer.saveAndApply()"
                  class="btn-game px-5 py-2.5 rounded-xl bg-[#43B02A] text-white font-bold text-sm">
            Save & Apply to Game
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- =====================================================================
       CONFIRMATION DIALOG (Replaces window.confirm cleanly)
       ===================================================================== -->
  <div id="confirmModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-[#18221B]/60 backdrop-blur-sm">
    <div class="bg-white max-w-md w-full rounded-3xl p-6 border-2 border-[#BFE3C6] shadow-2xl animate-pop text-center space-y-4">
      <div class="text-4xl">🍀</div>
      <h3 id="confirmTitle" class="text-xl font-extrabold text-[#18221B]">Return to Main Menu?</h3>
      <p id="confirmMessage" class="text-sm text-[#4A5D50]">Current game progress will be reset if you leave now.</p>
      <div class="flex justify-center gap-3 pt-2">
        <button onclick="App.closeConfirm()" class="px-4 py-2.5 rounded-xl bg-[#F0F7F2] hover:bg-[#E1EFE5] text-[#18221B] font-bold text-sm border border-[#CBE6D1]">
          Keep Playing
        </button>
        <button id="confirmProceedBtn" class="btn-game px-5 py-2.5 rounded-xl bg-[#FF6600] text-white font-bold text-sm">
          Exit to Menu
        </button>
      </div>
    </div>
  </div>

  <!-- =====================================================================
       GAME ENGINE & CLOVER NETWORK CONFIGURATION
       ===================================================================== -->
