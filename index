      syncOut() {
        if (this.state.mode === "LIVE") {
          LiveSync.broadcast({
            screen: this.state.screen,
            mode: this.state.mode,
            roundIndex: this.state.roundIndex,
            questionIndex: this.state.questionIndex,
            timeLeft: this.state.timeLeft,
            players: this.state.players,
            lastResults: this.state.lastResults
          });
        }
      },

      // --- QUESTION FLOW ---
      beginQuestion() {
        this.stopTimer();
        this.state.screen = "QUESTION";
        this.state.timeLeft = GAME_CONFIG.secondsPerQuestion || 25;
        this.state.activeTurnIndex = 0;
        this.state.players.forEach(p => {
          p.currentInput = "";
          p.submitted = false;
        });
        this.render();
        this.syncOut();

        setTimeout(() => {
          const inp = document.getElementById("answerInput0") || document.getElementById("soloAnswerInput");
          if (inp) inp.focus();
        }, 60);

        this.state.timerInterval = setInterval(() => {
          this.state.timeLeft--;
          const timerEl = document.getElementById("timerNumber");
          const barEl = document.getElementById("timerProgressBar");
          if (timerEl) {
            timerEl.textContent = `${this.state.timeLeft}s`;
            if (this.state.timeLeft <= 5) {
              timerEl.classList.remove("text-[#287A18]");
              timerEl.classList.add("text-[#FF6600]", "scale-110");
              SoundEngine.playTap();
            }
          }
          if (barEl) {
            const pct = Math.max(0, (this.state.timeLeft / (GAME_CONFIG.secondsPerQuestion || 25)) * 100);
            barEl.style.width = `${pct}%`;
            if (this.state.timeLeft <= 5) {
              barEl.classList.remove("bg-[#43B02A]");
              barEl.classList.add("bg-[#FF6600]");
            }
          }

          if (this.state.timeLeft <= 0) {
            this.lockInAllAnswers();
          }
        }, 1000);
      },

      stopTimer() {
        if (this.state.timerInterval) {
          clearInterval(this.state.timerInterval);
          this.state.timerInterval = null;
        }
      },

      submitSoloAnswer(e) {
        if (e) e.preventDefault();
        const inp = document.getElementById("soloAnswerInput");
        if (inp) {
          this.state.players[0].currentInput = inp.value;
        }
        this.lockInAllAnswers();
      },

      submitPassAndPlayTurn(e) {
        if (e) e.preventDefault();
        const idx = this.state.activeTurnIndex;
        const inp = document.getElementById("passPlayInput");
        if (inp) {
          this.state.players[idx].currentInput = inp.value;
          this.state.players[idx].submitted = true;
        }
        SoundEngine.playTap();

        if (idx + 1 < this.state.players.length) {
          this.state.activeTurnIndex++;
          this.render();
          setTimeout(() => document.getElementById("passPlayInput")?.focus(), 50);
        } else {
          this.lockInAllAnswers();
        }
      },

      updateHostLiveInput(playerIndex, value) {
        if (this.state.players[playerIndex]) {
          this.state.players[playerIndex].currentInput = value;
        }
      },

      lockInAllAnswers() {
        this.stopTimer();
        const round = GAME_CONFIG.rounds[this.state.roundIndex];
        const question = round.questions[this.state.questionIndex];

        if (this.state.mode === "LIVE" && this.state.liveInputMode === "SIMULTANEOUS_HOST") {
          this.state.players.forEach((p, idx) => {
            const el = document.getElementById(`answerInput${idx}`);
            if (el) p.currentInput = el.value;
          });
        }

        let bestTierIndex = -1;
        let anyMatched = false;

        this.state.lastResults = this.state.players.map(player => {
          const evalRes = AnswerMatcher.evaluate(player.currentInput, question);
          const pts = evalRes.matched ? evalRes.tier.points : 0;

          player.score += pts;
          const tIdx = evalRes.matched
            ? GAME_CONFIG.rarityTiers.findIndex(t => t.id === evalRes.tier.id)
            : -1;
          if (tIdx > player.highestTierIdx) {
            player.highestTierIdx = tIdx;
          }

          player.history.push({
            round: this.state.roundIndex + 1,
            questionPrompt: question.prompt,
            answer: player.currentInput || "(No answer)",
            matched: evalRes.matched,
            tierName: evalRes.tier ? evalRes.tier.name : "Not on Board",
            points: pts
          });

          if (evalRes.matched) {
            anyMatched = true;
            if (tIdx > bestTierIndex) bestTierIndex = tIdx;
          }

          return {
            playerId: player.id,
            playerName: player.name,
            rawInput: player.currentInput,
            matched: evalRes.matched,
            tier: evalRes.tier,
            matchedItem: evalRes.matchedItem,
            points: pts,
            totalScore: player.score
          };
        });

        if (anyMatched) {
          SoundEngine.playUnlock(bestTierIndex);
          if (bestTierIndex >= 3) {
            CloverCanvas.burstCelebration(GAME_CONFIG.rarityTiers[bestTierIndex].color);
          }
        } else {
          SoundEngine.playMiss();
        }

        this.state.screen = "REVEAL";
        this.render();
        this.syncOut();
      },

      advanceAfterReveal() {
        SoundEngine.playTap();
        const currentRound = GAME_CONFIG.rounds[this.state.roundIndex];
        if (this.state.questionIndex + 1 < currentRound.questions.length) {
          this.state.questionIndex++;
          this.beginQuestion();
        } else if (this.state.roundIndex === 0 && GAME_CONFIG.rounds.length > 1) {
          this.state.screen = "HALFTIME";
          this.render();
          this.syncOut();
        } else {
          CloverCanvas.burstCelebration("#43B02A");
          SoundEngine.playUnlock(4);
          this.state.screen = "FINAL";
          this.render();
          this.syncOut();
        }
      },

      startRoundTwo() {
        SoundEngine.playChimeStart();
        this.state.roundIndex = 1;
        this.state.questionIndex = 0;
        this.beginQuestion();
      },

