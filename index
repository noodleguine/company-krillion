                  { label: "Shakshuka", aliases: ["shakshuka"] },
                  { label: "Corned Beef Hash", aliases: ["corned beef hash", "corned beef"] },
                  { label: "Dutch Baby / Crepes", aliases: ["dutch baby", "crepes", "crepe"] }
                ]
