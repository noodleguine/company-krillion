                      <span class="font-extrabold text-[#18221B]">Total: ${res.totalScore} pts</span>
                    </div>
                  </div>
                `;
              }).join("")}
            </div>

            <!-- Predetermined Clover Hardware Rarity Board -->
            <div>
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#526658] mb-2.5">
                🗺️ Predetermined Clover Rarity Chart (Clover Go → Clover Kiosk)
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5">
                ${GAME_CONFIG.rarityTiers.map(tier => {
                  const items = (question.answers && question.answers[tier.id]) || [];
                  return `
                    <div class="p-3 rounded-2xl bg-[#F8FCF9] border border-[#D5E8DA] flex flex-col gap-2">
                      <div class="flex items-center justify-between border-b border-[#E1EFE5] pb-1.5">
                        <div class="flex items-center gap-1.5 min-w-0">
                          ${this.renderTierAssetHTML(tier, "text-lg", "w-7 h-7")}
                          <div class="min-w-0">
                            <div class="text-[9px] font-bold uppercase text-[#627868] leading-none">${tier.legacyTier}</div>
                            <div class="font-extrabold text-xs truncate" style="color: ${tier.color}">${tier.shortName}</div>
                          </div>
                        </div>
                        <span class="text-[11px] font-extrabold text-[#18221B] shrink-0">+${tier.points}</span>
                      </div>
                      <ul class="space-y-1 text-xs">
                        ${items.map(item => {
                          const label = typeof item === "string" ? item : item.label;
                          const wasPicked = this.state.lastResults.some(r => r.matched && r.matchedItem === label);
                          return `
                            <li class="px-2 py-1 rounded-lg ${wasPicked ? 'bg-[#43B02A] text-white font-extrabold shadow-sm' : 'bg-white border border-[#E6F2EA] text-[#2B3A30] font-medium'}">
                              ${wasPicked ? "🍀 " : ""}${this.escapeHTML(label)}
                            </li>
                          `;
                        }).join("")}
                      </ul>
                    </div>
                  `;
                }).join("")}
              </div>
            </div>
          </div>
        `;
      },

      // 5. ROUND 1 INTERMISSION / HALFTIME LEADERBOARD
      viewHalftime() {
        const sorted = [...this.state.players].sort((a, b) => b.score - a.score);
        return `
          <div class="clover-card rounded-3xl p-6 sm:p-9 max-w-3xl mx-auto w-full text-center animate-pop space-y-6">
            <div>
              <span class="px-3.5 py-1 rounded-full bg-[#EAF7EC] border border-[#BFE3C6] text-[#287A18] text-xs font-extrabold uppercase tracking-wider">
                🍀 Round 1 Complete (7 / 14 Questions)
              </span>
              <h2 class="text-3xl sm:text-4xl font-extrabold text-[#18221B] mt-3">
                Halftime Leaderboard
              </h2>
              <p class="text-sm text-[#4A5D50] mt-1 font-medium">
                Great start! Round 2 brings 7 more questions to unlock Clover Station Duo & Clover Kiosk.
              </p>
            </div>

            <!-- Standings -->
            <div class="space-y-2.5 text-left">
              ${sorted.map((p, idx) => {
                const bestTier = p.highestTierIdx >= 0 ? GAME_CONFIG.rarityTiers[p.highestTierIdx] : null;
                return `
                  <div class="flex items-center justify-between p-3.5 rounded-2xl bg-[#F8FCF9] border-2 ${idx === 0 ? 'border-[#43B02A]' : 'border-[#D5E8DA]'}">
                    <div class="flex items-center gap-3">
                      <span class="w-8 h-8 rounded-xl ${idx === 0 ? 'bg-[#43B02A] text-white' : 'bg-[#E4F3E8] text-[#18221B]'} font-display font-extrabold flex items-center justify-center">
                        #${idx + 1}
                      </span>
                      <div>
                        <div class="font-extrabold text-[#18221B] text-base">${this.escapeHTML(p.name)}</div>
                        <div class="text-xs text-[#526658] font-medium">
                          ${bestTier ? `Best Unlock: ${bestTier.name}` : "Warming up!"}
                        </div>
                      </div>
                    </div>
                    <div class="text-right">
                      <div class="font-display font-extrabold text-xl text-[#287A18]">${p.score} pts</div>
                    </div>
                  </div>
                `;
              }).join("")}
            </div>

            <button onclick="App.startRoundTwo()"
                    class="btn-game px-8 py-4 rounded-2xl bg-[#43B02A] hover:bg-[#389922] text-white font-extrabold text-lg">
              🍀 Start Round 2 (Final 7 Questions) →
            </button>
          </div>
        `;
      },

      // 6. FINAL RESULTS SCREEN
      viewFinal() {
        const sorted = [...this.state.players].sort((a, b) => b.score - a.score);
        const champion = sorted[0];

        let rankBadge = "Clover Go Starter";
        if (champion.score >= 130) rankBadge = "One-in-a-Krillion Kiosk Champion 👑";
        else if (champion.score >= 90) rankBadge = "Station Duo Powerhouse 🖥️";
        else if (champion.score >= 55) rankBadge = "Clover Flex All-Star 📱";
        else if (champion.score >= 25) rankBadge = "Clover Mini Pro ✨";

        return `
          <div class="clover-card rounded-3xl p-6 sm:p-9 max-w-4xl mx-auto w-full text-center animate-pop space-y-6">
            <div>
              <div class="inline-block animate-bob mb-2">
                ${this.renderMascotHTML("text-6xl", "w-20 h-20")}
              </div>
              <div class="text-xs font-extrabold uppercase tracking-widest text-[#FF6600]">
                🏆 Final Results • ${GAME_CONFIG.companyName} (${GAME_CONFIG.parentCompany})
              </div>
              <h2 class="text-3xl sm:text-5xl font-extrabold text-[#18221B] mt-1">
                ${this.escapeHTML(champion.name)} Wins!
              </h2>
              <p class="text-sm sm:text-base text-[#287A18] font-bold mt-1">
                Title Unlocked: <span class="text-[#FF6600]">${rankBadge}</span> (${champion.score} pts)
              </p>
            </div>

            <!-- Final Podium / Roster -->
            <div class="space-y-2.5 text-left max-w-2xl mx-auto">
              ${sorted.map((p, idx) => {
                const medal = idx === 0 ? "🥇" : idx === 1 ? "🥈" : idx === 2 ? "🥉" : `#${idx + 1}`;
                const bestTier = p.highestTierIdx >= 0 ? GAME_CONFIG.rarityTiers[p.highestTierIdx] : null;
                return `
                  <div class="flex items-center justify-between p-4 rounded-2xl bg-[#F8FCF9] border-2 ${idx === 0 ? 'border-[#43B02A] shadow-md' : 'border-[#D5E8DA]'}">
                    <div class="flex items-center gap-3">
                      <span class="text-2xl">${medal}</span>
                      <div>
                        <div class="font-extrabold text-[#18221B] text-base sm:text-lg">${this.escapeHTML(p.name)}</div>
                        <div class="text-xs text-[#526658] font-semibold">
                          ${bestTier ? `Rarest Device Unlocked: ${bestTier.name}` : "Completed all 14 questions"}
                        </div>
                      </div>
                    </div>
                    <div class="flex items-center gap-3">
                      ${bestTier ? this.renderTierAssetHTML(bestTier, "text-2xl", "w-10 h-10") : ""}
                      <div class="font-display font-extrabold text-2xl text-[#287A18]">${p.score} pts</div>
                    </div>
                  </div>
                `;
              }).join("")}
            </div>

            <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
              <button onclick="App.state.mode === 'SOLO' ? App.startSoloGame() : App.openLiveLobby()"
                      class="btn-game px-7 py-3.5 rounded-2xl bg-[#43B02A] hover:bg-[#389922] text-white font-extrabold text-base">
                🔄 Play Again
              </button>
              <button onclick="App.state.screen='HOME'; CloverCanvas.setScoreProgress(0); App.render();"
                      class="px-5 py-3.5 rounded-2xl bg-[#F0F7F2] hover:bg-[#E1EFE5] text-[#18221B] font-bold text-sm border border-[#CBE6D1]">
                Return to Home Screen
              </button>
            </div>
          </div>
        `;
      },

      escapeHTML(str) {
        return String(str || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }
    };

    /**
     * =========================================================================
     * 7. BUILT-IN CUSTOMIZATION STUDIO & GITHUB PAGES STATIC EXPORTER
     * =========================================================================
     */
    const Customizer = {
      activeTab: "branding",
      draftConfig: null,
      selectedRoundIdx: 0,
      selectedQuestionIdx: 0,

      open() {
        this.draftConfig = JSON.parse(JSON.stringify(GAME_CONFIG));
        const modal = document.getElementById("customizerModal");
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        this.switchTab(this.activeTab);
      },

      close() {
        const modal = document.getElementById("customizerModal");
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      },

      switchTab(tab) {
        this.activeTab = tab;
        document.querySelectorAll(".studio-tab").forEach(btn => {
          btn.classList.remove("border-[#43B02A]", "text-[#287A18]");
          btn.classList.add("border-transparent", "text-[#5A6E60]");
        });
        const activeBtn = document.getElementById(`tabBtn-${tab}`);
        if (activeBtn) {
          activeBtn.classList.add("border-[#43B02A]", "text-[#287A18]");
          activeBtn.classList.remove("border-transparent", "text-[#5A6E60]");
        }
        this.renderTab();
      },

      renderTab() {
        const body = document.getElementById("customizerBody");
        if (this.activeTab === "branding") {
          body.innerHTML = this.renderBrandingTab();
        } else if (this.activeTab === "assets") {
          body.innerHTML = this.renderAssetsTab();
        } else if (this.activeTab === "questions") {
          body.innerHTML = this.renderQuestionsTab();
        } else if (this.activeTab === "github") {
          body.innerHTML = this.renderGithubGuideTab();
        }
      },

      renderBrandingTab() {
        const c = this.draftConfig;
        const themes = [
          { id: "clover-mint", name: "Clover Crisp White & Soft Mint (Default)", swatch: "from-[#43B02A] to-[#EAF7EC]" },
          { id: "clover-pure", name: "Pure Studio White & Clover Green", swatch: "from-[#43B02A] to-white" },
          { id: "fiserv-citrus", name: "Clover Green + Fiserv Orange Glow", swatch: "from-[#43B02A] to-[#FF6600]" },
          { id: "emerald-meadow", name: "Fresh Botanical Emerald", swatch: "from-emerald-600 to-emerald-100" }
        ];

        return `
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="space-y-4">
              <div>
                <label class="block text-xs font-extrabold uppercase text-[#287A18] mb-1">Company / Organization Name</label>
                <input type="text" value="${App.escapeHTML(c.companyName)}"
                       oninput="Customizer.draftConfig.companyName = this.value"
                       class="w-full px-4 py-2.5 rounded-xl bg-white border border-[#CBE6D1] text-[#18221B] text-sm font-semibold" />
              </div>
              <div>
                <label class="block text-xs font-extrabold uppercase text-[#287A18] mb-1">Game Title</label>
                <input type="text" value="${App.escapeHTML(c.gameTitle)}"
                       oninput="Customizer.draftConfig.gameTitle = this.value"
                       class="w-full px-4 py-2.5 rounded-xl bg-white border border-[#CBE6D1] text-[#18221B] text-sm font-semibold" />
              </div>
              <div>
                <label class="block text-xs font-extrabold uppercase text-[#287A18] mb-1">Tagline / Subtitle</label>
                <input type="text" value="${App.escapeHTML(c.tagline)}"
                       oninput="Customizer.draftConfig.tagline = this.value"
                       class="w-full px-4 py-2.5 rounded-xl bg-white border border-[#CBE6D1] text-[#18221B] text-sm" />
              </div>
              <div>
                <label class="block text-xs font-extrabold uppercase text-[#287A18] mb-1">Seconds Per Question</label>
                <input type="number" min="10" max="120" value="${c.secondsPerQuestion}"
                       oninput="Customizer.draftConfig.secondsPerQuestion = Math.max(10, parseInt(this.value) || 25)"
                       class="w-32 px-4 py-2.5 rounded-xl bg-white border border-[#CBE6D1] text-[#18221B] text-sm font-bold" />
              </div>
            </div>

            <div class="space-y-3">
              <label class="block text-xs font-extrabold uppercase text-[#287A18]">Background Theme Accent</label>
              ${themes.map(t => `
                <div onclick="Customizer.draftConfig.themePreset='${t.id}'; Customizer.renderTab();"
                     class="cursor-pointer p-3.5 rounded-2xl border-2 flex items-center justify-between ${c.themePreset === t.id ? 'bg-[#EAF7EC] border-[#43B02A]' : 'bg-white border-[#D5E8DA]'}">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br ${t.swatch} border border-[#CBE6D1]"></div>
                    <span class="font-bold text-sm text-[#18221B]">${t.name}</span>
                  </div>
                  <span class="text-xs font-extrabold text-[#287A18]">${c.themePreset === t.id ? "✓ Active" : ""}</span>
                </div>
              `).join("")}
            </div>
          </div>
        `;
      },

      renderAssetsTab() {
        const c = this.draftConfig;
        const quickEmojis = ["🍀", "💳", "📱", "🖥️", "🏪", "☕", "🚀", "🏆", "⭐", "🎉"];

        return `
          <div class="space-y-6">
            <!-- Mascot Customizer -->
            <div class="p-4 rounded-2xl bg-white border border-[#D5E8DA] space-y-3">
              <h3 class="text-sm font-extrabold text-[#287A18] uppercase">Clover Mascot / Team Avatar</h3>
              <div class="flex flex-wrap items-center gap-4">
                <div class="w-16 h-16 rounded-2xl bg-[#F4FAF6] border border-[#BFE3C6] flex items-center justify-center text-4xl">
                  ${c.mascot.type === "image"
                    ? `<img src="${c.mascot.value}" class="w-12 h-12 object-contain rounded-lg">`
                    : c.mascot.type === "svg" && CLOVER_SVGS[c.mascot.value]
                    ? `<div class="w-12 h-12">${CLOVER_SVGS[c.mascot.value]}</div>`
                    : c.mascot.value}
                </div>
                <div class="flex-1 space-y-2">
                  <div class="flex flex-wrap gap-1.5">
                    <button onclick="Customizer.draftConfig.mascot={name:Customizer.draftConfig.mascot.name, type:'svg', value:'cloverMascot'}; Customizer.renderTab();"
                            class="px-2.5 h-9 rounded-lg bg-[#EAF7EC] hover:bg-[#DCF2E1] text-xs font-extrabold text-[#287A18] border border-[#BFE3C6]">
                      Clover Vector SVG
                    </button>
                    ${quickEmojis.map(em => `
                      <button onclick="Customizer.draftConfig.mascot={name:Customizer.draftConfig.mascot.name, type:'emoji', value:'${em}'}; Customizer.renderTab();"
                              class="w-9 h-9 rounded-lg bg-[#F4FAF6] hover:bg-[#E4F3E8] text-xl flex items-center justify-center border border-[#D5E8DA]">
                        ${em}
                      </button>
                    `).join("")}
                  </div>
                  <div class="flex flex-wrap items-center gap-2">
                    <label class="cursor-pointer px-3 py-1.5 rounded-xl bg-[#EAF7EC] hover:bg-[#DCF2E1] text-[#287A18] border border-[#BFE3C6] text-xs font-extrabold">
                      📁 Upload Custom PNG / Logo
                      <input type="file" accept="image/*" class="hidden" onchange="Customizer.handleMascotUpload(event)" />
                    </label>
                    <input type="text" value="${App.escapeHTML(c.mascot.name)}" placeholder="Mascot Name"
                           oninput="Customizer.draftConfig.mascot.name = this.value"
                           class="px-3 py-1.5 rounded-xl bg-white border border-[#CBE6D1] text-xs font-semibold text-[#18221B]" />
                  </div>
                </div>
              </div>
            </div>

            <!-- 5 Clover Hardware Tier Assets -->
            <div class="space-y-3">
              <h3 class="text-sm font-extrabold text-[#287A18] uppercase">Clover Hardware Level Graphics (Placeholder SVGs or Custom PNGs)</h3>
              <p class="text-xs text-[#526658]">Each tier currently includes a custom vector illustration of that Clover device. Upload your own official product renders anytime!</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                ${c.rarityTiers.map((tier, idx) => `
                  <div class="p-3.5 rounded-2xl bg-white border border-[#D5E8DA] flex items-center gap-3">
                    <div class="w-14 h-14 rounded-xl bg-[#F4FAF6] border border-[#CBE6D1] flex items-center justify-center text-2xl shrink-0">
                      ${tier.assetType === "image"
                        ? `<img src="${tier.assetValue}" class="w-11 h-11 object-contain">`
                        : tier.assetType === "svg" && CLOVER_SVGS[tier.assetValue]
                        ? `<div class="w-11 h-11">${CLOVER_SVGS[tier.assetValue]}</div>`
                        : tier.assetValue}
                    </div>
                    <div class="flex-1 space-y-1.5 min-w-0">
                      <div class="flex items-center gap-2">
                        <input type="text" value="${App.escapeHTML(tier.name)}"
                               oninput="Customizer.draftConfig.rarityTiers[${idx}].name = this.value; Customizer.draftConfig.rarityTiers[${idx}].shortName = this.value;"
                               class="flex-1 px-2.5 py-1 rounded-lg bg-[#F8FCF9] border border-[#CBE6D1] text-xs font-extrabold text-[#18221B]" />
                        <span class="text-xs font-extrabold text-[#287A18] shrink-0">+${tier.points} pts</span>
                      </div>
                      <div class="flex flex-wrap items-center gap-1.5">
                        <label class="cursor-pointer px-2.5 py-1 rounded-lg bg-[#EAF7EC] hover:bg-[#DCF2E1] text-[11px] text-[#287A18] font-bold border border-[#BFE3C6]">
                          📁 Upload PNG
                          <input type="file" accept="image/*" class="hidden" onchange="Customizer.handleTierAssetUpload(event, ${idx})" />
                        </label>
                        ${CLOVER_SVGS[tier.id] ? `
                          <button onclick="Customizer.draftConfig.rarityTiers[${idx}].assetType='svg'; Customizer.draftConfig.rarityTiers[${idx}].assetValue='${tier.id}'; Customizer.renderTab();"
                                  class="px-2 py-1 rounded-lg bg-[#F4FAF6] hover:bg-[#E4F3E8] text-[11px] text-[#526658] font-semibold border border-[#D5E8DA]">
                            Use Vector SVG
                          </button>
                        ` : ""}
                      </div>
                    </div>
                  </div>
                `).join("")}
              </div>
            </div>
          </div>
        `;
      },

      renderQuestionsTab() {
        const c = this.draftConfig;
        const round = c.rounds[this.selectedRoundIdx];
        const q = round.questions[this.selectedQuestionIdx];

        return `
          <div class="space-y-4">
            <!-- Round & Question Selector Pills -->
            <div class="flex flex-wrap items-center justify-between gap-2 bg-white p-3 rounded-2xl border border-[#D5E8DA]">
              <div class="flex gap-2">
                ${c.rounds.map((r, rIdx) => `
                  <button onclick="Customizer.selectedRoundIdx=${rIdx}; Customizer.selectedQuestionIdx=0; Customizer.renderTab();"
                          class="px-3.5 py-1.5 rounded-xl text-xs font-extrabold ${this.selectedRoundIdx === rIdx ? 'bg-[#43B02A] text-white' : 'bg-[#F0F7F2] text-[#18221B]'}">
                    Round ${r.roundNumber} (7 Qs)
                  </button>
                `).join("")}
              </div>

              <div class="flex flex-wrap gap-1.5">
                ${round.questions.map((_, qIdx) => `
                  <button onclick="Customizer.selectedQuestionIdx=${qIdx}; Customizer.renderTab();"
                          class="w-8 h-8 rounded-lg text-xs font-extrabold ${this.selectedQuestionIdx === qIdx ? 'bg-[#FF6600] text-white' : 'bg-[#F0F7F2] text-[#18221B] hover:bg-[#E1EFE5]'}">
                    Q${qIdx + 1}
                  </button>
                `).join("")}
              </div>
            </div>

            <!-- Question Prompt & Hint Editor -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div class="md:col-span-2">
                <label class="block text-xs font-extrabold uppercase text-[#287A18] mb-1">
                  Round ${round.roundNumber} — Question ${this.selectedQuestionIdx + 1} Prompt
                </label>
                <input type="text" value="${App.escapeHTML(q.prompt)}"
                       oninput="Customizer.draftConfig.rounds[${this.selectedRoundIdx}].questions[${this.selectedQuestionIdx}].prompt = this.value"
                       class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-[#CBE6D1] text-[#18221B] text-sm font-bold" />
              </div>
              <div>
                <label class="block text-xs font-extrabold uppercase text-[#287A18] mb-1">Optional Tip</label>
                <input type="text" value="${App.escapeHTML(q.hint || "")}"
                       oninput="Customizer.draftConfig.rounds[${this.selectedRoundIdx}].questions[${this.selectedQuestionIdx}].hint = this.value"
                       class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-[#CBE6D1] text-[#18221B] text-sm" />
              </div>
            </div>

            <!-- Predetermined Rarity Lists Editor -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
              ${c.rarityTiers.map(tier => {
                const entries = (q.answers && q.answers[tier.id]) || [];
                const textValue = entries.map(e => typeof e === "string" ? e : e.label).join("\n");
                return `
                  <div class="p-3 rounded-2xl bg-white border border-[#D5E8DA] flex flex-col gap-1.5">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-extrabold" style="color: ${tier.color}">${tier.shortName}</span>
                      <span class="text-[11px] font-extrabold text-[#526658]">+${tier.points}</span>
                    </div>
                    <textarea rows="6"
                              placeholder="One answer per line..."
                              oninput="Customizer.updateTierAnswers('${tier.id}', this.value)"
                              class="w-full p-2 rounded-xl bg-[#F8FCF9] border border-[#CBE6D1] text-xs text-[#18221B] font-medium leading-relaxed">${App.escapeHTML(textValue)}</textarea>
                    <span class="text-[10px] text-[#627868]">1 answer per line</span>
                  </div>
                `;
              }).join("")}
            </div>
          </div>
        `;
      },

      renderGithubGuideTab() {
        return `
          <div class="space-y-4 text-sm text-[#18221B]">
            <div class="p-4 rounded-2xl bg-[#EAF7EC] border border-[#BFE3C6]">
              <h3 class="font-extrabold text-[#287A18] text-base">🚀 3-Step GitHub Pages Deployment</h3>
              <ol class="list-decimal list-inside space-y-2 mt-2 text-xs sm:text-sm text-[#18221B]">
                <li>Customize your Clover & Fiserv questions, swap in official hardware PNGs in Tab 2, and review all 14 prompts in Tab 3.</li>
                <li>Click <strong>"Download GitHub Pages HTML"</strong> in the top-right corner of this modal. It bakes all your custom images & questions directly into a single self-contained <code class="text-[#287A18] font-bold">index.html</code> file!</li>
                <li>Push <code class="text-[#287A18] font-bold">index.html</code> to a GitHub repository and enable <strong>Settings → Pages → Deploy from branch (main)</strong>.</li>
              </ol>
            </div>

            <div class="p-4 rounded-2xl bg-white border border-[#D5E8DA] space-y-2">
              <h3 class="font-extrabold text-[#18221B] text-base">🎙️ Hosting Live Clover / Fiserv Team Games</h3>
              <ul class="list-disc list-inside space-y-1.5 text-xs sm:text-sm text-[#4A5D50]">
                <li><strong>Zoom / Teams All-Hands:</strong> Click <em>Host Live Company Game</em>, add team names, and screen-share the board. Have teams send their picks before locking in!</li>
                <li><strong>Projector Mirror Mode:</strong> Use <em>Open Synced Projector Tab</em> in the Live Lobby to keep a clean projection screen synced with your host control tab.</li>
              </ul>
            </div>
          </div>
        `;
      },

      updateTierAnswers(tierId, multilineText) {
        const q = this.draftConfig.rounds[this.selectedRoundIdx].questions[this.selectedQuestionIdx];
        if (!q.answers) q.answers = {};
        const lines = multilineText
          .split("\n")
          .map(line => line.trim())
          .filter(Boolean);
        q.answers[tierId] = lines.map(label => ({ label, aliases: [label] }));
      },

      handleMascotUpload(event) {
        const file = event.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          this.draftConfig.mascot.type = "image";
          this.draftConfig.mascot.value = e.target.result;
          this.renderTab();
        };
        reader.readAsDataURL(file);
      },

      handleTierAssetUpload(event, tierIdx) {
        const file = event.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          this.draftConfig.rarityTiers[tierIdx].assetType = "image";
          this.draftConfig.rarityTiers[tierIdx].assetValue = e.target.result;
          this.renderTab();
        };
        reader.readAsDataURL(file);
      },

      saveAndApply() {
        GAME_CONFIG = JSON.parse(JSON.stringify(this.draftConfig));
        try {
          localStorage.setItem("clover_krillion_config_v1", JSON.stringify(GAME_CONFIG));
        } catch (e) {
          console.warn("Storage quota warning:", e);
        }
        App.applyBrandingToChrome();
        App.render();
        this.close();
        App.showToast("Clover Krillion customizations saved & applied!", "success");
      },

      resetToDefaults() {
        localStorage.removeItem("clover_krillion_config_v1");
        GAME_CONFIG = JSON.parse(JSON.stringify(DEFAULT_GAME_CONFIG));
        this.draftConfig = JSON.parse(JSON.stringify(DEFAULT_GAME_CONFIG));
        App.applyBrandingToChrome();
        this.renderTab();
        App.render();
        App.showToast("Restored Clover default template!", "info");
      },

      exportStaticHTML() {
        const configToBake = this.draftConfig || GAME_CONFIG;
        const fullHTML = document.documentElement.outerHTML;
        const serializedConfig = JSON.stringify(configToBake, null, 2);

        const bakedHTML = "<!DOCTYPE html>\n" + fullHTML.replace(
          /const DEFAULT_GAME_CONFIG = [\s\S]*?;\n\n    \/\/ Active mutable config/,
          `const DEFAULT_GAME_CONFIG = ${serializedConfig};\n\n    // Active mutable config`
        );

        const blob = new Blob([bakedHTML], { type: "text/html;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "index.html";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        App.showToast("Downloaded custom Clover index.html for GitHub Pages!", "success");
      }
    };

    // Boot Application on Window Load
    window.onload = () => {
      App.init();
    };
  </script>
</body>
</html>
