      }
      return JSON.parse(JSON.stringify(DEFAULT_GAME_CONFIG));
    }

    /**
     * =========================================================================
     * 2. SYNTHESIZED WEB AUDIO CLOVER POS CHIME ENGINE (Zero External Files!)
     * =========================================================================
     */
    const SoundEngine = {
      ctx: null,
      enabled: true,

      init() {
        if (!this.ctx && (window.AudioContext || window.webkitAudioContext)) {
          this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (this.ctx && this.ctx.state === "suspended") {
          this.ctx.resume();
        }
      },

      toggle() {
        this.enabled = !this.enabled;
        document.getElementById("soundIcon").textContent = this.enabled ? "🔊" : "🔇";
        if (this.enabled) {
          this.init();
          this.playTap();
        }
      },

      playTap() {
        if (!this.enabled) return;
        try {
          this.init();
          const now = this.ctx.currentTime;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = "sine";
          osc.frequency.setValueAtTime(520, now);
          osc.frequency.exponentialRampToValueAtTime(880, now + 0.1);
          gain.gain.setValueAtTime(0.11, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.11);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.12);
        } catch (e) {}
      },

      playChimeStart() {
        if (!this.enabled) return;
        try {
          this.init();
          const now = this.ctx.currentTime;
          [587.33, 880].forEach((freq, i) => {
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = "sine";
            osc.frequency.setValueAtTime(freq, now + i * 0.09);
            gain.gain.setValueAtTime(0.12, now + i * 0.09);
            gain.gain.exponentialRampToValueAtTime(0.0008, now + i * 0.09 + 0.45);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now + i * 0.09);
            osc.stop(now + i * 0.09 + 0.46);
          });
        } catch (e) {}
      },

      playUnlock(tierIndex) {
        if (!this.enabled) return;
        try {
          this.init();
          const now = this.ctx.currentTime;
          // Crisp Clover POS Tap-to-Pay ascending arpeggio based on hardware tier!
          const notes = [523.25, 659.25, 783.99, 1046.5, 1318.5];
          const count = Math.min(tierIndex + 2, notes.length);
          for (let i = 0; i < count; i++) {
            const chime = this.ctx.createOscillator();
            const cGain = this.ctx.createGain();
            chime.type = "triangle";
            const start = now + i * 0.075;
            chime.frequency.setValueAtTime(notes[i], start);
            cGain.gain.setValueAtTime(0.14, start);
            cGain.gain.exponentialRampToValueAtTime(0.001, start + 0.34);
            chime.connect(cGain);
            cGain.connect(this.ctx.destination);
            chime.start(start);
            chime.stop(start + 0.35);
          }
        } catch (e) {}
      },

      playMiss() {
        if (!this.enabled) return;
        try {
          this.init();
          const now = this.ctx.currentTime;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = "triangle";
          osc.frequency.setValueAtTime(220, now);
          osc.frequency.linearRampToValueAtTime(145, now + 0.25);
          gain.gain.setValueAtTime(0.11, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.26);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.27);
        } catch (e) {}
      }
    };

    /**
     * =========================================================================
     * 3. AMBIENT FOUR-LEAF CLOVER & SOFT POS RIPPLE CANVAS (Crisp White Theme)
     * =========================================================================
     */
    const CloverCanvas = {
      canvas: null,
      ctx: null,
      clovers: [],
      ripples: [],
      particles: [],
      targetScore: 0,
      currentScore: 0,

      init() {
        this.canvas = document.getElementById("cloverCanvas");
        this.ctx = this.canvas.getContext("2d");
        this.resize();
        window.addEventListener("resize", () => this.resize());

        // Spawn gentle floating four-leaf clovers across the white background
        for (let i = 0; i < 24; i++) {
          this.clovers.push({
            x: Math.random() * window.innerWidth,
            y: Math.random() * window.innerHeight,
            size: 14 + Math.random() * 20,
            vx: (Math.random() - 0.5) * 0.45,
            vy: -0.25 - Math.random() * 0.45,
            angle: Math.random() * Math.PI * 2,
            vAngle: (Math.random() - 0.5) * 0.012,
            alpha: 0.08 + Math.random() * 0.14,
            hueShift: Math.random() > 0.2 ? "#43B02A" : "#2E8B57"
          });
        }

        // Spawn soft contactless tap-to-pay rings
        for (let i = 0; i < 4; i++) {
          this.ripples.push({
            x: Math.random() * window.innerWidth,
            y: Math.random() * window.innerHeight,
            r: Math.random() * 140,
            maxR: 160 + Math.random() * 90,
            speed: 0.35 + Math.random() * 0.25
          });
        }

        this.loop();
      },

      resize() {
        if (!this.canvas) return;
        this.canvas.width = window.innerWidth;
        this.canvas.height = window.innerHeight;
      },

      setScoreProgress(points) {
        this.targetScore = points;
        const overlay = document.getElementById("depthOverlay");
        if (!overlay) return;

        const themeGradients = {
          "clover-mint": "radial-gradient(circle at 50% 0%, rgba(67, 176, 42, 0.10), rgba(244, 250, 246, 0.84) 74%, rgba(255, 255, 255, 0.96) 100%)",
          "clover-pure": "radial-gradient(circle at 50% 0%, rgba(67, 176, 42, 0.05), rgba(255, 255, 255, 0.95) 80%)",
          "fiserv-citrus": "radial-gradient(circle at 50% 0%, rgba(255, 102, 0, 0.08), rgba(244, 250, 246, 0.85) 70%, rgba(255, 255, 255, 0.96) 100%)",
          "emerald-meadow": "radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.12), rgba(236, 253, 245, 0.85) 75%, rgba(255, 255, 255, 0.96) 100%)"
        };
        overlay.style.background = themeGradients[GAME_CONFIG.themePreset] || themeGradients["clover-mint"];
      },

      burstCelebration(primaryColor = "#43B02A") {
        for (let i = 0; i < 48; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 2.5 + Math.random() * 6.5;
          this.particles.push({
            x: this.canvas.width / 2,
            y: this.canvas.height / 2,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 2.5,
            size: 5 + Math.random() * 6,
            color: i % 3 === 0 ? "#FF6600" : primaryColor,
            isClover: i % 2 === 0,
            angle: Math.random() * Math.PI * 2,
            life: 1.0
          });
        }
      },

      drawFourLeafClover(ctx, size, color, alpha) {
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.fillStyle = color;
        const r = size * 0.34;
        const offset = size * 0.26;
        // 4 heart-like rounded leaves
        const coords = [
          [-offset, -offset],
          [offset, -offset],
          [-offset, offset],
          [offset, offset]
        ];
        coords.forEach(([lx, ly]) => {
          ctx.beginPath();
          ctx.arc(lx, ly, r, 0, Math.PI * 2);
          ctx.fill();
        });
        // Center white dot
        ctx.fillStyle = "#FFFFFF";
        ctx.beginPath();
        ctx.arc(0, 0, size * 0.1, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      },

      loop() {
        const ctx = this.ctx;
        const w = this.canvas.width;
        const h = this.canvas.height;
        ctx.clearRect(0, 0, w, h);

        // 1. Subtle Contactless Tap-to-Pay Expanding Rings
        this.ripples.forEach(rp => {
          rp.r += rp.speed;
          if (rp.r > rp.maxR) {
            rp.r = 10;
            rp.x = Math.random() * w;
            rp.y = Math.random() * h;
          }
          const alpha = (1 - rp.r / rp.maxR) * 0.08;
          ctx.beginPath();
          ctx.arc(rp.x, rp.y, rp.r, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(67, 176, 42, ${alpha})`;
          ctx.lineWidth = 1.6;
          ctx.stroke();
        });

        // 2. Gentle Drifting Four-Leaf Clovers
        this.clovers.forEach(c => {
          c.x += c.vx;
          c.y += c.vy;
          c.angle += c.vAngle;

          if (c.y < -40) {
            c.y = h + 40;
            c.x = Math.random() * w;
          }
          if (c.x < -40) c.x = w + 40;
          if (c.x > w + 40) c.x = -40;

          ctx.save();
          ctx.translate(c.x, c.y);
          ctx.rotate(c.angle);
          this.drawFourLeafClover(ctx, c.size, c.hueShift, c.alpha);
          ctx.restore();
        });

        // 3. Celebration Confetti & Clover Burst
        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.13;
          p.angle += 0.08;
          p.life -= 0.018;
          if (p.life <= 0) {
            this.particles.splice(i, 1);
            continue;
          }
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.angle);
          if (p.isClover) {
            this.drawFourLeafClover(ctx, p.size * 2.2, p.color, p.life);
          } else {
            ctx.globalAlpha = p.life;
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(0, 0, p.size, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.restore();
        }

        requestAnimationFrame(() => this.loop());
      }
    };

    /**
     * =========================================================================
     * 4. FUZZY MATCHING & CLOVER RARITY SCORING ENGINE
     * =========================================================================
     */
    const AnswerMatcher = {
      normalize(str) {
        return (str || "")
          .toLowerCase()
          .replace(/^(a|an|the)\s+/i, "")
          .replace(/[^a-z0-9\s]/g, "")
          .replace(/\s+/g, " ")
          .trim();
      },

      levenshtein(a, b) {
        if (a.length === 0) return b.length;
        if (b.length === 0) return a.length;
        const matrix = Array.from({ length: b.length + 1 }, (_, i) => [i]);
        for (let j = 0; j <= a.length; j++) matrix[0][j] = j;
        for (let i = 1; i <= b.length; i++) {
          for (let j = 1; j <= a.length; j++) {
            const cost = b[i - 1] === a[j - 1] ? 0 : 1;
            matrix[i][j] = Math.min(
              matrix[i - 1][j] + 1,
              matrix[i][j - 1] + 1,
              matrix[i - 1][j - 1] + cost
            );
          }
        }
        return matrix[b.length][a.length];
      },

      evaluate(rawInput, questionObj) {
        const cleaned = this.normalize(rawInput);
        if (!cleaned) {
          return { matched: false, rawInput, tier: null, matchedItem: null };
        }

        // Evaluate from rarest (Clover Kiosk) down to most common (Clover Go)
        const tiersReversed = [...GAME_CONFIG.rarityTiers].reverse();

        for (const tier of tiersReversed) {
          const entries = (questionObj.answers && questionObj.answers[tier.id]) || [];
          for (const entry of entries) {
            const label = typeof entry === "string" ? entry : entry.label;
            const aliases = typeof entry === "string" ? [entry] : [entry.label, ...(entry.aliases || [])];

            for (const candidate of aliases) {
              const normCand = this.normalize(candidate);
              if (!normCand) continue;

              if (cleaned === normCand) {
                return { matched: true, rawInput, tier, matchedItem: label };
              }

              const dist = this.levenshtein(cleaned, normCand);
              const maxAllowed = normCand.length >= 8 ? 2 : normCand.length >= 5 ? 1 : 0;
              if (dist <= maxAllowed) {
                return { matched: true, rawInput, tier, matchedItem: label };
              }
            }
          }
        }

        return { matched: false, rawInput, tier: null, matchedItem: null };
      }
    };

    /**
     * =========================================================================
     * 5. LIVE BROADCAST SYNC (Cross-Tab / Multi-Window Live Host & Projector)
     * =========================================================================
     */
    const LiveSync = {
      channel: null,
      init() {
        if ("BroadcastChannel" in window) {
          this.channel = new BroadcastChannel("clover_krillion_live_v1");
          this.channel.onmessage = (event) => {
            if (event.data && event.data.type === "SYNC_STATE") {
              App.receiveSyncedState(event.data.payload);
            }
          };
        }
      },
      broadcast(stateSnapshot) {
        if (this.channel) {
          this.channel.postMessage({ type: "SYNC_STATE", payload: stateSnapshot });
        }
      }
    };

