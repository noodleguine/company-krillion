      receiveSyncedState(payload) {
        if (!payload) return;
        this.state.screen = payload.screen;
        this.state.mode = payload.mode;
        this.state.roundIndex = payload.roundIndex;
        this.state.questionIndex = payload.questionIndex;
        this.state.timeLeft = payload.timeLeft;
        this.state.players = payload.players;
        this.state.lastResults = payload.lastResults;
        this.render(true);
